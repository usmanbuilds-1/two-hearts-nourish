# Public client configuration (safe to expose only when using Supabase publishable keys)
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Server-only secrets. NEVER prefix these with VITE_ and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
OPEN_FOOD_FACTS_USER_AGENT=
USDA_FDC_API_KEY=

# Optional server-side quota ceilings. Defaults are conservative if omitted.
AI_MEMBER_DAILY_CAP_SCAN=12
AI_MEMBER_DAILY_CAP_TEXT=30
AI_MEMBER_DAILY_CAP_PLAN=4
AI_MEMBER_DAILY_CAP_STRONG_SCAN=4
AI_GLOBAL_DAILY_CAP_SCAN=1000
AI_GLOBAL_DAILY_CAP_TEXT=2000
AI_GLOBAL_DAILY_CAP_PLAN=250
AI_GLOBAL_DAILY_CAP_STRONG_SCAN=250

# Scanner V2 stays off until migrations + benchmark smoke checks pass.
VITE_SCANNER_V2_ENABLED=false
